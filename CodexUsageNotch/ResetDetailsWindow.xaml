<Window x:Class="CodexUsageNotch.ResetDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DetailsTitle}"
        Width="288"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        FontFamily="{DynamicResource InterfaceFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SourceInitialized="OnSourceInitialized">
    <Viewbox Stretch="Uniform" VerticalAlignment="Top">
        <Grid x:Name="PopoverRoot" Width="288">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PopoverOffset" />
            </Grid.RenderTransform>
            <Grid Margin="8,0,8,10">
                <Grid.Resources>
                    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextWrapping" Value="NoWrap" />
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="7" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Path Data="M 0,7 L 8,0 L 16,7 Z"
                      Width="16" Height="7"
                      HorizontalAlignment="Center"
                      Fill="{DynamicResource PopoverSurfaceBrush}"
                      Stroke="{DynamicResource PopoverBorderBrush}"
                      StrokeThickness="0.8" />

                <Border Grid.Row="1"
                        Background="{DynamicResource PopoverSurfaceBrush}"
                        BorderBrush="{DynamicResource PopoverBorderBrush}"
                        BorderThickness="0.8"
                        CornerRadius="11">
                    <Border.Effect>
                        <DropShadowEffect Color="#A8000000"
                                          BlurRadius="12"
                                          ShadowDepth="3"
                                          Opacity="{DynamicResource PopoverShadowOpacity}"
                                          Direction="270" />
                    </Border.Effect>
                    <Grid>
                        <Border CornerRadius="10"
                                Background="{DynamicResource GlassSheenBrush}"
                                Opacity="0.45"
                                IsHitTestVisible="False" />
                        <Grid Margin="13,8,13,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <TextBlock Text="{Binding DetailsTitle}" FontSize="12.5" FontWeight="SemiBold" />
                                <Border Padding="8,2"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="9"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DetailsBadge}"
                                               Foreground="{DynamicResource AccentLabelBrush}"
                                               FontSize="11"
                                               FontWeight="Medium" />
                                </Border>
                            </Grid>

                            <Border Grid.Row="1" Background="{DynamicResource DividerBrush}" />

                            <ItemsControl Grid.Row="2" ItemsSource="{Binding CreditRows}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowQuotaDetails}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="30">
                                            <Grid x:Name="CreditRow">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Width="14" Height="14"
                                                         VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M 20,11 A 8,8 0 1 1 17.7,5.2 M 17.7,1.8 L 17.7,5.8 L 13.7,5.8"
                                                              Stroke="{DynamicResource SecondaryTextBrush}"
                                                              StrokeThickness="1.8"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Fill="Transparent" />
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="12" FontWeight="Medium"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Expiration}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           FontSize="11.5" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <TextBlock x:Name="MessageRow" Text="{Binding Expiration}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="11.5" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsMessage}" Value="True">
                                                <Setter TargetName="CreditRow" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="MessageRow" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding QuotaRows}"
                                          Visibility="{Binding ShowQuotaDetails, Converter={StaticResource BoolVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,9,0,3">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="18" />
                                                <RowDefinition Height="4" />
                                                <RowDefinition Height="22" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Label}" FontWeight="Medium"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="{Binding RemainingText}" HorizontalAlignment="Right"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentLabelBrush}" />
                                            <ProgressBar Grid.Row="1" Minimum="0" Maximum="100"
                                                         Value="{Binding RemainingPercent}" IsHitTestVisible="False"
                                                         AutomationProperties.Name="{Binding Label}">
                                                <ProgressBar.Template>
                                                    <ControlTemplate TargetType="ProgressBar">
                                                        <Grid x:Name="PART_Track">
                                                            <Border Background="{DynamicResource ProgressTrackBrush}" CornerRadius="2" />
                                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                                    Background="{DynamicResource AccentBrush}" CornerRadius="2" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </ProgressBar.Template>
                                            </ProgressBar>
                                            <TextBlock Grid.Row="2" Text="{Binding ResetText}" FontSize="11.5"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
